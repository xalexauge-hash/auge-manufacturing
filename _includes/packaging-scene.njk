<svg class="ax-machine ax-packaging" data-packaging-scene viewBox="0 0 900 620" role="img" aria-label="Doppelstöckige Förderanlage mit Kistenaufrichtung, Teilebefüllung und Palettierung" hidden>
  <defs>
    <linearGradient id="pack-steel" x2="0" y2="1"><stop stop-color="#d6e1e5"/><stop offset=".5" stop-color="#5c7481"/><stop offset="1" stop-color="#233d4a"/></linearGradient>
    <pattern id="pack-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="#52717d" stroke-opacity=".16"/></pattern>
  </defs>
  <rect x="30" y="75" width="840" height="480" fill="url(#pack-grid)"/>
  <g class="pack-frame" fill="#293e49" stroke="#7a929c" stroke-width="2">
    {% for x in [175,335,495,655,795] %}<path d="M{{x}} 278V470h12V278Z"/><path d="M{{x-12}} 470h36v7h-36Z"/>{% endfor %}
    <path d="M175 465L335 300M335 465L495 300M495 465L655 300M655 465L795 300" stroke="#506976" stroke-width="4"/>
  </g>
  <g class="pack-lower">
    <path d="M162 390H808V425H162Z" fill="#12232c" stroke="#7c939d" stroke-width="3"/>
    {% for x in range(168,805,18) %}<rect x="{{x}}" y="391" width="11" height="28" rx="5" fill="url(#pack-steel)"/>{% endfor %}
    <path d="M160 390H810M160 421H810" stroke="#b2c3ca" stroke-width="5"/>
    <path d="M240 438H710l-10 -5m10 5l-10 5" fill="none" stroke="#74bdc8" stroke-width="2"/>
    <text x="350" y="460">UNTERGESCHOSS / KISTENSTAPEL →</text>
  </g>
  <g class="pack-upper">
    <path d="M162 270H808V304H162Z" fill="#152c35" stroke="#8ba4ae" stroke-width="3"/>
    {% for x in range(168,805,18) %}<rect x="{{x}}" y="271" width="11" height="26" rx="5" fill="url(#pack-steel)"/>{% endfor %}
    <path d="M160 269H810M160 302H810" stroke="#cad7da" stroke-width="5"/>
    <path d="M700 320H255l10 -5m-10 5l10 5" fill="none" stroke="#74bdc8" stroke-width="2"/>
    <text x="355" y="343">← OBERGESCHOSS / AUFGERICHTETE KISTEN</text>
    {% for x in [245,475,740] %}<rect x="{{x}}" y="302" width="12" height="12" fill="#e3a743"/><circle cx="{{x+6}}" cy="306" r="2" fill="#8cf1d6"/>{% endfor %}
    <rect x="793" y="310" width="30" height="23" rx="4" fill="#526a79" stroke="#b7c8ce"/><circle cx="809" cy="322" r="7" fill="#263943"/>
  </g>
  <g class="pack-feed">
    <rect x="452" y="62" width="58" height="131" fill="#142d38" stroke="#9ab3bd" stroke-width="3"/>
    {% for y in range(72,190,14) %}<rect x="454" y="{{y}}" width="54" height="8" rx="3" fill="url(#pack-steel)"/>{% endfor %}
    <path d="M449 62V193M513 62V193" stroke="#bdced4" stroke-width="4"/>
    <g data-feed-parts fill="#8ac6d7" stroke="#e0f5fb">{% for y in [76,112,148] %}<rect x="469" y="{{y}}" width="24" height="16" rx="3"/><circle cx="481" cy="{{y+8}}" r="3" fill="#264956"/>{% endfor %}</g>
    <text x="525" y="82">FERTIGTEILE</text><path d="M530 98v66l-5 -8m5 8l5 -8" stroke="#83c7ce" fill="none"/>
  </g>
  <g class="pack-worker" stroke="#b9ced5" stroke-width="3" fill="#315365">
    <circle cx="94" cy="352" r="12" fill="#dfb99b" stroke="#dfb99b"/><path d="M78 371h30l8 49H74Z"/><path d="M81 420l-7 43m29 -43l9 43" stroke-width="9"/>
    <path data-worker-arm d="M105 380L128 397L149 390" fill="none" stroke-width="8"/>
    <path d="M70 465H85M106 465H122" stroke-width="6"/><text x="58" y="495" stroke="none" fill="#c1d4dd">BEREITSTELLUNG</text>
  </g>
  <g class="pack-pallet" stroke="#caa575" stroke-width="2" fill="#70563b">
    <path d="M43 257H133V271H43Z"/><path d="M47 271v12h15v-12m23 0v12h15v-12m16 0v12h13v-12"/>
    {% for x in [47,67,87,107,127] %}<path d="M{{x}} 258v12"/>{% endfor %}
    <g data-pallet-load fill="#ab8050"><rect x="48" y="233" width="37" height="23"/><rect x="88" y="233" width="37" height="23"/><path d="M50 234l12 21m28 -21l12 21" stroke="#d6bc8a"/></g>
    <text x="45" y="305" stroke="none" fill="#c1d4dd">PALETTE</text>
  </g>
  <g class="pack-robots">
    {% for robot in [{id:'erect',x:799,y:195,n:'01',label:'AUFRICHTEN'},{id:'fill',x:594,y:155,n:'02',label:'BEFÜLLEN'},{id:'pallet',x:235,y:148,n:'03',label:'PALETTIEREN'}] %}
    <g data-pack-robot="{{robot.id}}">
      <rect x="{{robot.x-22}}" y="{{robot.y-20}}" width="44" height="40" rx="5" fill="#263f4a" stroke="#a7c1ca"/>
      <circle cx="{{robot.x}}" cy="{{robot.y}}" r="18" fill="#d4403d" stroke="#fc9980" stroke-width="3"/>
      <path data-pack-arm d="M{{robot.x}} {{robot.y}}l-25 30l-20 30" fill="none" stroke="#283f4b" stroke-width="22" stroke-linecap="round"/>
      <path data-pack-arm d="M{{robot.x}} {{robot.y}}l-25 30l-20 30" fill="none" stroke="url(#pack-steel)" stroke-width="14" stroke-linejoin="round" stroke-linecap="round"/>
      <circle data-pack-elbow r="11" fill="#d4403d" stroke="#ffd1bb" stroke-width="2"/>
      <g data-pack-tool><rect x="-16" y="-5" width="32" height="10" rx="3" fill="#172f3b" stroke="#d7e3e6"/><path d="M-12 5v6m24 -6v6" stroke="#72bcbf" stroke-width="4"/></g>
      <text x="{{robot.x-45}}" y="{{robot.y-36}}">{{robot.n}} / {{robot.label}}</text>
    </g>
    {% endfor %}
  </g>
  <g data-pack-stack transform="translate(220 388)" fill="#a88a62" stroke="#ead2a8" stroke-width="1.5">
    {% for y in [0,-6,-12,-18,-24] %}<path d="M-25 {{y}}h50v-5h-50Z"/><path d="M-8 {{y-1}}l16 -3"/>{% endfor %}
  </g>
  <g data-pack-box transform="translate(745 262)">
    <g data-box-shape fill="#ae8150" stroke="#f0c693" stroke-width="1.5">
      <path d="M-27 -26L0 -36L27 -26V0L0 10L-27 0Z"/>
      <path d="M-27 -26L0 -16L27 -26M0 -16V10" fill="none"/>
      <path d="M-27 -26L0 -36L27 -26L0 -16Z" fill="#3c382f"/>
      <path data-box-flaps d="M-27 -26l-8 -12l27 10l8 12m0 0l8 -12l27 -10l-8 12" fill="#cc9b61"/>
      <g data-box-fill fill="#8ac6d7" stroke="#d4eff5">{% for p in [{x:-15,y:-28},{x:1,y:-33},{x:-2,y:-23},{x:12,y:-28}] %}<rect data-filled-part x="{{p.x}}" y="{{p.y}}" width="11" height="7" rx="2"/>{% endfor %}</g>
    </g>
  </g>
  <g data-pack-part fill="#8ac6d7" stroke="#e2f5fb"><rect x="-10" y="-6" width="20" height="12" rx="3"/><circle r="3" fill="#284955"/></g>
  <g class="pack-controls">
    <rect x="610" y="485" width="155" height="50" rx="4" fill="#112b37" stroke="#658d9e"/>
    <rect x="619" y="493" width="78" height="32" fill="#082027" stroke="#3a6e7d"/><path d="M627 502h54m-54 8h35m-35 8h44" stroke="#78c9b4" stroke-width="2"/>
    <circle cx="713" cy="502" r="5" fill="#69d3ae"/><circle cx="737" cy="502" r="6" fill="#de5345"/>
    <text x="618" y="552">STEUERUNG / FREIGABEN</text>
    <path d="M610 510H490V480M765 510H830V310" stroke="#527582" stroke-dasharray="5 5" fill="none"/>
  </g>
  <g class="pack-planning" fill="none" stroke="#f1a483" stroke-width="2" stroke-dasharray="6 7">
    <path d="M155 395H747V269H244L86 240"/><path d="M481 80V263"/>
  </g>
  <text x="45" y="580" class="pack-caption">ZWEI EBENEN · DREI ROBOTER · EIN MATERIALFLUSS</text>
  {% include "fabrication-scene.njk" %}
</svg>
