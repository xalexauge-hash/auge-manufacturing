<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if seo.title %}{{ seo.title }}{% else %}{{ title }} | {{ company.name }}{% endif %}</title>
    <meta name="description" content="{% if seo.description %}{{ seo.description }}{% else %}{{ company.description }}{% endif %}">
    <link rel="canonical" href="{{ site.url }}{{ page.url | replace('//', '/') }}">
    {% if seo.noindex %}
    <meta name="robots" content="noindex, nofollow">
    {% else %}
    <meta name="robots" content="index, follow">
    {% endif %}
    <!-- Open Graph -->
    <meta property="og:title" content="{% if seo.title %}{{ seo.title }}{% else %}{{ title }} | {{ company.name }}{% endif %}">
    <meta property="og:description" content="{% if seo.description %}{{ seo.description }}{% else %}{{ company.description }}{% endif %}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}{{ page.url | replace('//', '/') }}">
    <meta property="og:image" content="{% if seo.image %}{{ site.url }}{{ seo.image }}{% else %}{{ site.url }}/public/images/og-default.svg{% endif %}">
    <!-- TODO: Ersetzen durch echtes OG-Bild, z.B. og-default.jpg -->
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if seo.title %}{{ seo.title }}{% else %}{{ title }} | {{ company.name }}{% endif %}">
    <meta name="twitter:description" content="{% if seo.description %}{{ seo.description }}{% else %}{{ company.description }}{% endif %}">
    <meta name="twitter:image" content="{% if seo.image %}{{ site.url }}{{ seo.image }}{% else %}{{ site.url }}/public/images/og-default.svg{% endif %}">
    <!-- TODO: Ersetzen durch echtes OG-Bild -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "{{ company.name }}",
      "url": "{{ site.url }}",
    "logo": "{{ site.url }}/public/auge_manufacturing_logo.png",
    "email": "{{ company.email }}",
    "telephone": "{{ company.phone }}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ company.street }}",
        "postalCode": "{{ company.postalCode }}",
        "addressLocality": "{{ company.city }}",
        "addressCountry": "{{ company.country }}"
      },
            "description": "{{ company.description }}",
            "areaServed": ["Riedering","Rosenheim","Chiemgau","Oberbayern","München"]
    }
    </script>
    <link rel="stylesheet" href="/public/style.css">
    <link rel="stylesheet" href="/public/refinement.css">
    <link rel="stylesheet" href="/public/experience.css?v=playlist1">
    <script src="/public/experience.js?v=playlist1" defer></script>
    <link rel="stylesheet" href="/public/pages-modern.css">
    <link rel="stylesheet" href="/public/layout-modern.css">
    <link rel="stylesheet" href="/public/motion.css">
    <script src="/public/motion.js" defer></script>
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="48x48" href="/public/images/fav_ico.png">
    <link rel="shortcut icon" href="/public/images/fav_ico.png">

</head>
<body>
<script>document.documentElement.classList.add("js");</script>
<a class="skip-link" href="#main-content">Zum Inhalt springen</a>

    <header class="site-dock">
      <a class="dock-brand" href="/" aria-label="AUGÉ Manufacturing – Start"><img src="/public/auge_manufacturing_logo.png" alt="AUGÉ Manufacturing" width="541" height="267"></a>
      <nav class="dock-nav" aria-label="Hauptnavigation">
        <button class="dock-toggle" type="button" aria-expanded="false" aria-controls="navLinks"><span>Menü</span><span class="menu-lines" aria-hidden="true"></span></button>
        <div class="dock-links" id="navLinks">
          <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Start</a>
          <a href="/ueber-uns/"{% if page.url == '/ueber-uns/' %} aria-current="page"{% endif %}>Über uns</a>
          <a href="/leistungen/"{% if page.url == '/leistungen/' %} aria-current="page"{% endif %}>Leistungen</a>
          <a href="/maschinenpark/"{% if page.url == '/maschinenpark/' %} aria-current="page"{% endif %}>Maschinenpark</a>
          <a class="dock-contact" href="/kontakt/"{% if page.url == '/kontakt/' %} aria-current="page"{% endif %}>Kontakt <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </header>

    <main id="main-content">
        {{ content | safe }}
    </main>

    <footer class="site-outro">
      <div class="outro-top"><span class="eyebrow">AUGÉ Manufacturing / Riedering</span><a class="outro-top-link" href="#main-content">Zurück nach oben <span aria-hidden="true">↑</span></a></div>
      <a class="outro-invitation" href="/kontakt/"><span>Was möchten<br>Sie bewegen?</span><span class="outro-arrow" aria-hidden="true">↗</span></a>
      <div class="outro-contact"><p>Ihre technische Aufgabe.<br>Unser nächstes Gespräch.</p><div><a href="mailto:{{ company.contact.email }}">{{ company.contact.email }}</a><a href="tel:{{ company.contact.phone }}">{{ company.contact.phone }}</a></div></div>
      <div class="outro-bottom"><span>© 2026 AUGÉ Manufacturing GmbH</span><span>{{ company.contact.address }}</span><div><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></div></div>
      <div class="outro-wordmark" aria-hidden="true"><img src="/public/auge_manufacturing_logo.png" alt="" width="541" height="267" loading="lazy"></div>
    </footer>
    <script>
      (() => {
        const toggle = document.querySelector('.dock-toggle');
        const links = document.querySelector('.dock-links');
        const close = () => { toggle.setAttribute('aria-expanded', 'false'); links.classList.remove('is-open'); };
        toggle.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); links.classList.toggle('is-open', open); });
        links.addEventListener('click', event => { if (event.target.closest('a')) close(); });
        document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); } });
        document.addEventListener('click', event => { if (!event.target.closest('.site-dock')) close(); });
        window.matchMedia('(min-width: 901px)').addEventListener('change', close);
      })();
    </script>
</body>
</html>
